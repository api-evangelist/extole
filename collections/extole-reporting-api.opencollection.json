{
  "opencollection": "1.0.0",
  "info": {
    "name": "Integration API - Consumer to Extole Audiences Reporting API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reporting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "readLatestReport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v4/reports/latest",
            "params": [
              {
                "name": "tags",
                "value": "",
                "type": "query"
              },
              {
                "name": "exclude_tags",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "downloadLatestReport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v4/reports/latest/download:format",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "tags",
                "value": "",
                "type": "query"
              },
              {
                "name": "exclude_tags",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "readReport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v4/reports/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "downloadReport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v4/reports/:reportId/download:format",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              },
              {
                "name": "format",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getReportInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v4/reports/:reportId/info/:format",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              },
              {
                "name": "format",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Get dimension combinations.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v6/dimensions",
            "params": [
              {
                "name": "campaign_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "program_label",
                "value": "",
                "type": "query"
              },
              {
                "name": "container",
                "value": "",
                "type": "query"
              },
              {
                "name": "step_name",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get dimension combinations."
        },
        {
          "info": {
            "name": "Get dimension values.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{brand}.extole.io/v6/dimensions/:dimensionName",
            "params": [
              {
                "name": "dimensionName",
                "value": "",
                "type": "path"
              },
              {
                "name": "campaign_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "program_label",
                "value": "",
                "type": "query"
              },
              {
                "name": "container",
                "value": "",
                "type": "query"
              },
              {
                "name": "time_period",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get dimension values."
        }
      ]
    }
  ],
  "bundled": true
}